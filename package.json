{
  "name": "lll-experience",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun run lint",
    "lint": "eslint . && tsc --noEmit",
    "fmt": "biome format --write .",
    "format": "biome format --write .",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate --schema=./src/db/schema.ts --dialect=postgresql",
    "db:studio": "drizzle-kit studio --dialect=postgresql",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:seed": "bun run src/db/seed.ts",
    "sleeper:ingest": "bun run scripts/ingest-sleeper.ts",
    "cortanha:snapshot": "bun run scripts/freeze-cortanha-baseline.ts",
    "test:smoke": "playwright test tests/smoke.ts --reporter=line --retries=2"
  },
  "dependencies": {
    "@bogeychan/elysia-logger": "^0.1.10",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.29",
    "elysia-clerk": "^1.0.2",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@josh803316/shared-config": "3.1.0",
    "@playwright/test": "^1.62.1",
    "bun-types": "^1.4.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "playwright": "^1.62.1",
    "playwright-stealth": "^0.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.68.0",
    "xlsx": "^0.18.5"
  },
  "trustedDependencies": [
    "@clerk/shared",
    "@josh803316/shared-config",
    "esbuild"
  ],
  "engines": {
    "npm": "****** PLEASE USE 'bun install', NPM IS NOT SUPPORTED ******"
  },
  "overrides": {
    "@clerk/backend": "2.32.0"
  },
  "patchedDependencies": {
    "@clerk/backend@2.32.0": "patches/@clerk%2Fbackend@2.32.0.patch"
  }
}
